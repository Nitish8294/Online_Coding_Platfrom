# =========================================
# MERN STACK PROJECT .gitignore
# =========================================

# === Node modules ===
node_modules/
**/node_modules/

# === Environment files (keep your secrets safe) ===
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# === Build and production outputs ===
build/
dist/
out/
.cache/
.next/
coverage/

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Temporary and cache files ===
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*.seed
*.pid
*.pid.lock

# === OS generated files ===
.DS_Store
Thumbs.db

# === Editor / IDE specific ===
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# === Backend specific ===
backend/node_modules/
backend/.env
backend/logs/
backend/dist/
backend/uploads/
backend/temp/
backend/.cache/

# === Frontend specific ===
frontend/node_modules/
frontend/.env
frontend/build/
frontend/dist/
frontend/.cache/
frontend/.next/

# === Misc files ===
*.tgz
*.zip
*.tar.gz
*.rar

# === TypeScript / Babel (if used) ===
*.tsbuildinfo
*.tscache/

# === PM2 logs (if using PM2 process manager) ===
pids/
pmlogs/
